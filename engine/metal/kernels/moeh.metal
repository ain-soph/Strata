template <int F> struct DecH;
// IQ2_S: unit ui (16 weights) of a 256 block = grids l = 2h, 2h + 1 of group ib (moe.metal / quant.metal deq<T_IQ2_S>)
template <> struct DecH<T_IQ2_S> {
    static inline void run(device const uchar* row, int u, thread uint* q, thread float4& sc) {
        device const uchar* b = row + (u >> 4) * 82;
        const int ui = u & 15, ib = ui >> 1, h = ui & 1;
        const uint qh = b[66 + ib];
        for (int l2 = 0; l2 < 2; ++l2) {
            const int l = 2 * h + l2;
            const uint idx = uint(b[2 + 4 * ib + l]) | ((qh << (8 - 2 * l)) & 0x300);
            const uint4 g = iq2s_grid_h[idx], m = ksign_h[b[2 + 32 + 4 * ib + l]];
            q[4 * l2] = g.x ^ m.x;
            q[4 * l2 + 1] = g.y ^ m.y;
            q[4 * l2 + 2] = g.z ^ m.z;
            q[4 * l2 + 3] = g.w ^ m.w;
        }
        const uint scb = b[74 + ib];
        const float s = rdh(b) * (0.5f + float((scb >> (4 * h)) & 15)) * 0.25f;
        sc = float4(s, s, 0.0f, 0.0f);
    }
};
// IQ3_S: unit ui = grid pairs l = 2h, 2h + 1 of group ib (deq<T_IQ3_S>)
template <> struct DecH<T_IQ3_S> {
    static inline void run(device const uchar* row, int u, thread uint* q, thread float4& sc) {
        device const uchar* b = row + (u >> 4) * 110;
        const int ui = u & 15, ib = ui >> 1, h = ui & 1;
        const uint qh = b[66 + ib];
        for (int l2 = 0; l2 < 2; ++l2) {
            const int l = 2 * h + l2;
            const uint i1 = uint(b[2 + 8 * ib + 2 * l]) | ((qh << (8 - 2 * l)) & 256);
            const uint i2 = uint(b[2 + 8 * ib + 2 * l + 1]) | ((qh << (7 - 2 * l)) & 256);
            const uint2 g1 = iq3s_grid_h[i1], g2 = iq3s_grid_h[i2];
            const uint4 m = ksign_h[b[74 + 4 * ib + l]];
            q[4 * l2] = g1.x ^ m.x;
            q[4 * l2 + 1] = g1.y ^ m.y;
            q[4 * l2 + 2] = g2.x ^ m.z;
            q[4 * l2 + 3] = g2.y ^ m.w;
        }
        const uint scb = b[106 + (ib >> 1)];
        const float s = rdh(b) * float(1 + 2 * ((scb >> (4 * (ib & 1))) & 15));
        sc = float4(s, s, 0.0f, 0.0f);
    }
};

// unit_combine<16> on the half-packed weights: q[k] holds weights 2k, 2k + 1
static inline float unit_combine_h(thread const uint* q, float4 sc, thread const float* xs, thread const float* xsum) {
    if (hq_f16) {
        half s0 = 0, s1 = 0, s2 = 0, s3 = 0;
        for (int k = 0; k < 4; ++k) {
            const half2 a = as_type<half2>(q[k]), c = as_type<half2>(q[4 + k]);
            s0 = fma(a.x, half(xs[2 * k]), s0);
            s1 = fma(a.y, half(xs[2 * k + 1]), s1);
            s2 = fma(c.x, half(xs[8 + 2 * k]), s2);
            s3 = fma(c.y, half(xs[8 + 2 * k + 1]), s3);
        }
        return sc.x * float(s0 + s1) + sc.y * float(s2 + s3) - (sc.z * xsum[0] + sc.w * xsum[1]);
    }
    float s0 = 0, s1 = 0, s2 = 0, s3 = 0;
    for (int k = 0; k < 4; ++k) {
        const half2 a = as_type<half2>(q[k]), c = as_type<half2>(q[4 + k]);
        s0 = fma(float(a.x), xs[2 * k], s0);
        s1 = fma(float(a.y), xs[2 * k + 1], s1);
        s2 = fma(float(c.x), xs[8 + 2 * k], s2);
        s3 = fma(float(c.y), xs[8 + 2 * k + 1], s3);
    }
    return sc.x * (s0 + s1) + sc.y * (s2 + s3) - (sc.z * xsum[0] + sc.w * xsum[1]);
}

template <int F, int LPR, int NR, int NE>
static inline void guh_body(device const uchar* g0, device const uchar* u0, device const float* x,
                            device const float* xs16, device float* h, device const int* etok, int c, int row0, int li,
                            constant MoeArgs& a) {
    float ag[NR][NE], au[NR][NE];
    for (int r = 0; r < NR; ++r)
        for (int t = 0; t < NE; ++t) ag[r][t] = au[r][t] = 0.0f;
    const int U = int(a.n_embd) / 16;
    for (int u = li; u < U; u += LPR) {
        uint qg[NR][8], qu[NR][8];
        float4 cg[NR], cu[NR];
        for (int r = 0; r < NR; ++r) {
            DecH<F>::run(g0 + r * a.gu_row, u, qg[r], cg[r]);
            DecH<F>::run(u0 + r * a.gu_row, u, qu[r], cu[r]);
        }
        for (int t = 0; t < NE; ++t) {
            const int tok = etok[t];
            float xs[16], xsum[2];
            X<F>::load(x + tok * int(a.n_embd), xs16 + tok * int(a.n_embd / 16), u, xs, xsum);
            for (int r = 0; r < NR; ++r) {
                ag[r][t] += unit_combine_h(qg[r], cg[r], xs, xsum);
                au[r][t] += unit_combine_h(qu[r], cu[r], xs, xsum);
            }
        }
    }
    for (int r = 0; r < NR; ++r)
        for (int t = 0; t < NE; ++t) {
            const float gv = lane_sum<LPR>(ag[r][t]), uv = lane_sum<LPR>(au[r][t]);
            if (li == 0) h[(c + t) * int(a.n_ff) + row0 + r] = gv / (1.0f + exp(-gv)) * uv;
        }
}

// moe_gu's interface (the same buffers, so the host binds it the same way); no threadgroup table
template <int F, int LPR, int NR, int SG>
kernel void moe_guh(device const uchar* W [[buffer(0)]], device const float* x [[buffer(1)]],
                    device float* h [[buffer(2)]], device const int* plan [[buffer(3)]],
                    constant MoeArgs& a [[buffer(4)]], device const float* xs16 [[buffer(5)]],
                    device const uint* smap [[buffer(6)]], device const uchar* W1 [[buffer(7)]],
                    device const uchar* W2 [[buffer(8)]], device const uchar* W3 [[buffer(9)]],
                    uint3 tg [[threadgroup_position_in_grid]], ushort sg [[simdgroup_index_in_threadgroup]],
                    ushort lane [[thread_index_in_simdgroup]]) {
    constexpr int RG = 32 / LPR;
    const int g = int(tg.y);
    if (g >= plan[P_NG]) return;
    const int li = lane % LPR;
    const int row0 = ((int(tg.x) * SG + sg) * RG + lane / LPR) * NR;
    const ulong ex = (ulong)plan[P_GEXP + g];
    const int c = plan[P_GSTART + g], ne = plan[P_GSTART + g + 1] - c;
    device const int* etok = plan + P_ETOK + c;
    device const uchar* E = kArena ? arena_slot(smap[ex], W, W1, W2, W3) : W + ex * a.gu_stride;
    device const uchar* g0 = E + a.gate_off + (ulong)row0 * a.gu_row;
    device const uchar* u0 = E + a.up_off + (ulong)row0 * a.gu_row;
    switch (ne) {
        case 1: guh_body<F, LPR, NR, 1>(g0, u0, x, xs16, h, etok, c, row0, li, a); break;
        case 2: guh_body<F, LPR, NR, 2>(g0, u0, x, xs16, h, etok, c, row0, li, a); break;
        case 3: guh_body<F, LPR, NR, 3>(g0, u0, x, xs16, h, etok, c, row0, li, a); break;
        case 4: guh_body<F, LPR, NR, 4>(g0, u0, x, xs16, h, etok, c, row0, li, a); break;
        default:
            for (int k = 0; k < ne; k += 4) {
                const int m = min(4, ne - k);
                if (m == 4) guh_body<F, LPR, NR, 4>(g0, u0, x, xs16, h, etok + k, c + k, row0, li, a);
                else if (m == 3) guh_body<F, LPR, NR, 3>(g0, u0, x, xs16, h, etok + k, c + k, row0, li, a);
                else if (m == 2) guh_body<F, LPR, NR, 2>(g0, u0, x, xs16, h, etok + k, c + k, row0, li, a);
                else guh_body<F, LPR, NR, 1>(g0, u0, x, xs16, h, etok + k, c + k, row0, li, a);
            }
    }
}

